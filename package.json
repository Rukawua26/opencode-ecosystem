{
  "name": "opencode-ecosystem",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "description": "Open source ecosystem for OpenCode: memory, SDD, skills, multi-model agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rukawua26/opencode-ecosystem.git"
  },
  "author": "Rukawua26",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:install": "bash tests/install.test.sh",
    "test:install:windows": "pwsh -NoProfile -File tests/install.test.ps1",
    "test:hooks": "bash tests/hooks.test.sh",
    "test:release": "bash tests/release-tag.test.sh && bash tests/release-workflow.test.sh",
    "test:router": "node --test config/mcp/local-model-router.test.js",
    "eval:local-structure": "node tools/evals/local-model-structure.js",
    "check-docs": "node tools/scripts/check-docs.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18"
  }
}
