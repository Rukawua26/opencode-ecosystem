{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.4-mini",
  "subagent_depth": 1,
  "experimental": {
    "batch_tool": true,
    "disable_paste_summary": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1200,
      "max_height": 1200
    }
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.4-mini",
      "steps": 8,
      "permission": { "edit": "deny", "bash": "deny", "task": "deny" }
    },
    "scout": {
      "model": "openai/gpt-5.4-mini",
      "steps": 8,
      "permission": { "edit": "deny", "bash": "deny", "task": "deny" }
    },
    "title": { "model": "openai/gpt-5.4-mini" },
    "summary": { "model": "openai/gpt-5.4-mini" },
    "compaction": { "model": "openai/gpt-5.6-sol" }
  },
  "skills": {
    "paths": ["~/opencode-custom/skills"]
  },
  "plugin": [
    "./plugins/personalities.js",
    "./plugins/guardrails.js",
    "./plugins/checkpoints.js",
    "./plugins/kanban.js",
    "./plugins/sandbox.js",
    "./plugins/validator.js",
    "./plugins/session-metrics.js"
  ],
  "mcp": {
    "memory-adapter": {
      "type": "local",
      "command": ["node", "~/.config/opencode/mcp/memory-adapter/src/mcp-server.js"],
      "enabled": true,
      "timeout": 30000
    },
    "local-model-router": {
      "type": "local",
      "command": ["node", "~/.config/opencode/mcp/local-model-router.js"],
      "enabled": true,
      "timeout": 150000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": false
    },
    "diagram-generator": {
      "type": "local",
      "command": ["npx", "-y", "mcp-diagram-generator"],
      "enabled": false
    }
  },
  // Multi-modelo por fase SDD - routeado automatico de modelo por tipo de tarea
  // Specify/Plan: alto razonamiento (Gemini flash)
  // Tasks/Document: ligeras (gpt-5.4-mini)
  // Implement/Verify: robustas (gpt-5.4)
  // FALLBACKS: si el modelo principal falla, se usa el siguiente en la lista
  "sdd_multi_model": {
    "specify": {
      "primary": "google/gemini-2.5-flash",
      "fallback": ["anthropic/claude-3-5-sonnet", "openai/gpt-5.4", "openai/o1"],
      "reason": "Alto razonamiento para especificaciones"
    },
    "plan": {
      "primary": "google/gemini-2.5-flash",
      "fallback": ["anthropic/claude-3-5-sonnet", "openai/gpt-5.4", "openai/o1"],
      "reason": "Razonamiento para diseno tecnico"
    },
    "tasks": {
      "primary": "openai/gpt-5.4-mini",
      "fallback": ["google/gemini-2.5-flash", "openai/gpt-5.4-mini-high"],
      "reason": "Tareas ligeras, descomposicion"
    },
    "implement": {
      "primary": "openai/gpt-5.4",
      "fallback": ["anthropic/claude-3-5-sonnet", "openai/gpt-4.1", "google/gemini-2.5-pro"],
      "reason": "Implementacion robusta y codigo limpio"
    },
    "verify": {
      "primary": "openai/gpt-5.4",
      "fallback": ["openai/codex-2025-05-15", "google/gemini-2.5-pro", "anthropic/claude-3-5-sonnet"],
      "reason": "Deteccion de bugs y validacion"
    },
    "document": {
      "primary": "openai/gpt-5.4-mini",
      "fallback": ["google/gemini-2.5-flash", "openai/gpt-4.1"],
      "reason": "Documentacion ligera y clara"
    }
  }
}
