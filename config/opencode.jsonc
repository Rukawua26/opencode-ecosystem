{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-luna",
  "subagent_depth": 1,
  "experimental": {
    "batch_tool": true,
    "disable_paste_summary": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1200,
      "max_height": 1200
    }
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "steps": 8,
      "permission": { "edit": "deny", "bash": "deny", "task": "deny" }
    },
    "scout": {
      "model": "openai/gpt-5.6-luna",
      "steps": 8,
      "permission": { "edit": "deny", "bash": "deny", "task": "deny" }
    },
    "title": { "model": "openai/gpt-5.6-luna" },
    "summary": { "model": "openai/gpt-5.6-luna" },
    "compaction": { "model": "openai/gpt-5.6-luna" }
  },
  "skills": {
    "paths": ["~/opencode-custom/skills"]
  },
  "permission": {
    "review_mode_get": "allow",
    "review_status": "allow",
    "review_validate": "allow",
    "review_mode_set": "ask",
    "review_start": "ask",
    "review_capture": "ask",
    "review_verify": "ask",
    "review_finalize": "ask",
    "review_gate": "ask"
  },
  "plugin": [
    "./plugins/guardrails.js",
    "./plugins/checkpoints.js",
    "./plugins/validator.js",
    "./plugins/session-metrics.js",
    "./plugins/organic-rdd.js"
  ],
  "mcp": {
    "memory-adapter": {
      "type": "local",
      "command": ["node", "~/.config/opencode/mcp/memory-adapter/src/mcp-server.js"],
      "enabled": true,
      "timeout": 30000
    },
    "local-model-router": {
      "type": "local",
      "command": ["node", "~/.config/opencode/mcp/local-model-router.js"],
      "enabled": true,
      "timeout": 150000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": false
    },
    "diagram-generator": {
      "type": "local",
      "command": ["npx", "-y", "mcp-diagram-generator"],
      "enabled": false
    }
  }
}
