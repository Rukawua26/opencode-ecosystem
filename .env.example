# OpenCode Ecosystem - Environment Variables Example
# Copy this file to ~/.config/opencode/.env and fill in your keys
# NEVER commit your real .env file

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Ollama (local models)
# OLLAMA_HOST=http://localhost:11434

# Optional: Context7 MCP
# CONTEXT7_API_KEY=

# Optional: Notion MCP
# NOTION_API_KEY=

# Optional: Jira MCP
# JIRA_API_TOKEN=
# JIRA_HOST=
