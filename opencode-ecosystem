#!/usr/bin/env bash
# opencode-ecosystem — publish/sync/status/capture (lite). Fuente de verdad: ~/opencode-ecosystem.
# Nunca sincroniza: .env, observations.log, topics/, logs, backups, plugins personales.
set -u
ECO="$HOME/opencode-ecosystem"
CFG="$HOME/.config/opencode"
MANAGED="$CFG/.ecosystem-managed-files"

managed_list() {
  echo "opencode/opencode.jsonc"
  echo "opencode/dcp.jsonc"
  echo "opencode/cron-jobs.json"
  for f in "$ECO"/skills/*/SKILL.md; do
    [ -e "$f" ] || continue
    rel="opencode/skills/$(basename "$(dirname "$f")")/SKILL.md"; echo "$rel"
  done
  for f in "$ECO"/scripts/*.sh "$ECO"/memory/kairos.sh "$ECO"/memory/autodream.sh; do
    [ -e "$f" ] || continue
    case "$f" in
      */scripts/*) echo "opencode/scripts/$(basename "$f")" ;;
      */memory/*) echo "opencode/memory/$(basename "$f")" ;;
    esac
  done
  for f in "$ECO"/commands/*.md; do
    [ -e "$f" ] || continue
    echo "opencode/commands/$(basename "$f")"
  done
}

cmd_status() {
  local drift=0
  diff -q "$ECO/configs/opencode.jsonc" "$CFG/opencode.jsonc" >/dev/null 2>&1 || { echo "[drift] opencode.jsonc"; drift=1; }
  diff -q "$ECO/configs/dcp.jsonc" "$CFG/dcp.jsonc" >/dev/null 2>&1 || { echo "[drift] dcp.jsonc"; drift=1; }
  diff -q "$ECO/configs/cron-jobs.json" "$CFG/cron-jobs.json" >/dev/null 2>&1 || { echo "[drift] cron-jobs.json"; drift=1; }
  diff -rq "$ECO/skills" "$CFG/skills" >/dev/null 2>&1 || { echo "[drift] skills/"; drift=1; }
  diff -rq "$ECO/scripts" "$CFG/scripts" >/dev/null 2>&1 || { echo "[drift] scripts/"; drift=1; }
  if [ -d "$ECO/commands" ]; then
    diff -rq -x '*.bak-*' "$ECO/commands" "$CFG/commands" >/dev/null 2>&1 || { echo "[drift] commands/"; drift=1; }
  fi
  diff -q "$ECO/memory/kairos.sh" "$CFG/memory/kairos.sh" >/dev/null 2>&1 || { echo "[drift] memory/kairos.sh"; drift=1; }
  diff -q "$ECO/memory/autodream.sh" "$CFG/memory/autodream.sh" >/dev/null 2>&1 || { echo "[drift] memory/autodream.sh"; drift=1; }
  [ "$drift" = "0" ] && echo "[ok] sin drift"
  return "$drift"
}

backup_dest() { # $1 = destino en CFG
  local d="$1"
  [ ! -L "$d" ] || return 1
  [ ! -e "$d" ] || [ -f "$d" ] || return 1
  if [ -e "$d" ] && [ ! -L "$d" ]; then
    local bk
    bk=$(mktemp -d "$d.bak-XXXXXXXX") || return 1
    cp -a "$d" "$bk/" || return 1
    echo "[backup] $d"
  fi
  return 0
}

# No seguir enlaces en arboles gestionados ni en sus antecesores.
safe_tree() {
  local p="$1"
  while [ "$p" != / ]; do
    [ ! -L "$p" ] || { echo "[error] enlace no permitido: $p" >&2; return 1; }
    p=$(dirname "$p")
  done
  if [ -d "$1" ]; then
    local links
    links=$(find "$1" -type l -print -quit) || return 1
    [ -z "$links" ] || return 1
  fi
}

managed_path() {
  case "$1" in
    *..*|*//*|/*) return 1 ;;
    opencode/opencode.jsonc|opencode/dcp.jsonc|opencode/cron-jobs.json|opencode/memory/kairos.sh|opencode/memory/autodream.sh) ;;
    opencode/scripts/*.sh|opencode/commands/*.md|opencode/skills/*/SKILL.md)
      # Los patrones shell admiten '/': limitar ademas la profundidad.
      local tail="${1#opencode/}" rest
      rest="${tail#*/}"
      case "$tail" in
        skills/*) rest="${rest%/SKILL.md}" ;;
      esac
      case "$rest" in */*|'') return 1 ;; esac ;;
    *) return 1 ;;
  esac
  safe_tree "$CFG/${1#opencode/}"
}

cmd_sync() { # sync --apply : ECO -> CFG con backup; jsonc solo con config-apply --apply
  local apply="${1:-}"
  if [ "$apply" != "--apply" ]; then echo "uso: $0 sync --apply"; return 2; fi
  python3 "$ECO/validate-skills.py" "$ECO/skills" || return 1
  local tree
  # Comprobar solo lo que se copia o escribe; no recorrer personalizaciones.
  for tree in "$ECO/skills" "$CFG/skills" "$MANAGED" "$CFG/memory/MEMORY.md"; do
    safe_tree "$tree" || return 1
  done
  for tree in opencode.jsonc dcp.jsonc cron-jobs.json; do
    safe_tree "$ECO/configs/$tree" && safe_tree "$CFG/$tree" || return 1
  done
  for tree in "$ECO"/scripts/*.sh "$ECO"/commands/*.md "$ECO/memory/kairos.sh" "$ECO/memory/autodream.sh"; do
    [ -e "$tree" ] || [ -L "$tree" ] || continue
    safe_tree "$tree" && safe_tree "$CFG/${tree#"$ECO/"}" || return 1
  done
  safe_tree "$ECO/memory/MEMORY.md" || return 1
  # Los directorios tambien se validan cuando la fuente no tiene entradas.
  for tree in scripts commands memory; do
    [ ! -L "$CFG/$tree" ] || return 1
  done
  mkdir -p "$CFG/scripts" "$CFG/skills" "$CFG/memory" "$CFG/commands" || return 1
  for tree in opencode.jsonc dcp.jsonc cron-jobs.json; do
    cmp -s "$ECO/configs/$tree" "$CFG/$tree" && continue
    backup_dest "$CFG/$tree" || return 1
    cp "$ECO/configs/$tree" "$CFG/$tree" || return 1
  done
  cp -r "$ECO/skills/." "$CFG/skills/" || return 1
  for tree in "$ECO"/scripts/*.sh; do
    [ -e "$tree" ] || continue
    cmp -s "$tree" "$CFG/scripts/$(basename "$tree")" || cp "$tree" "$CFG/scripts/" || return 1
    chmod +x "$CFG/scripts/$(basename "$tree")" || return 1
  done
  if [ -d "$ECO/commands" ]; then
    for f in "$ECO"/commands/*.md; do
      [ -e "$f" ] || continue
      cmp -s "$f" "$CFG/commands/$(basename "$f")" && continue
      backup_dest "$CFG/commands/$(basename "$f")" || return 1
      cp "$f" "$CFG/commands/" || return 1
    done
  fi
  # Scripts de memoria gestionados: copia con backup solo si difieren.
  for s in kairos.sh autodream.sh; do
    cmp -s "$ECO/memory/$s" "$CFG/memory/$s" && continue
    backup_dest "$CFG/memory/$s" || return 1
    cp "$ECO/memory/$s" "$CFG/memory/$s" || return 1
  done
  # MEMORY.md se siembra solo si falta; logs/topics personales no se tocan.
  if [ ! -e "$CFG/memory/MEMORY.md" ]; then
    cp "$ECO/memory/MEMORY.md" "$CFG/memory/MEMORY.md" || return 1
  fi
  chmod +x "$CFG/memory/kairos.sh" "$CFG/memory/autodream.sh" || return 1
  managed_list > "$MANAGED" || return 1
  echo "[ok] sync aplicado"
}

cmd_publish() { # publish --yes : CFG -> ECO (solo gestionados)
  local yes="${1:-}"
  if [ "$yes" != "--yes" ]; then echo "uso: $0 publish --yes"; return 2; fi
  local tree stage
  for tree in "$CFG" "$ECO/configs" "$ECO/skills" "$ECO/scripts" "$ECO/commands"; do
    safe_tree "$tree" || return 1
  done
  stage=$(mktemp -d "$ECO/.publish-XXXXXXXX") || return 1
  if ! cp -r "$CFG/skills" "$stage/skills" || ! python3 "$ECO/validate-skills.py" "$stage/skills"; then
    rm -rf -- "$stage"
    return 1
  fi
  for tree in opencode.jsonc dcp.jsonc cron-jobs.json; do
    [ ! -e "$ECO/configs/$tree" ] || [ -f "$ECO/configs/$tree" ] || { rm -rf -- "$stage"; return 1; }
    cp "$CFG/$tree" "$ECO/configs/$tree" || { rm -rf -- "$stage"; return 1; }
  done
  cp "$CFG"/scripts/*.sh "$ECO/scripts/" || { rm -rf -- "$stage"; return 1; }
  if [ -d "$CFG/commands" ]; then
    mkdir -p "$ECO/commands" || { rm -rf -- "$stage"; return 1; }
    for tree in "$CFG"/commands/*.md; do
      [ -e "$tree" ] || continue
      cp "$tree" "$ECO/commands/" || { rm -rf -- "$stage"; return 1; }
    done
  fi
  mv "$ECO/skills" "$stage/original" || { rm -rf -- "$stage"; return 1; }
  if ! mv "$stage/skills" "$ECO/skills"; then
    mv "$stage/original" "$ECO/skills" || { echo "[error] restaurar skills desde $stage/original" >&2; return 1; }
    rm -rf -- "$stage"
    return 1
  fi
  rm -rf -- "$stage" || return 1
  echo "[ok] publish aplicado (sin .env/memoria/logs)"
}

cmd_capture() { # capture --apply : recuperación manual controlada CFG->ECO incluyendo memoria template (no logs vivos)
  local apply="${1:-}"
  if [ "$apply" != "--apply" ]; then echo "uso: $0 capture --apply"; return 2; fi
  cmd_publish --yes
}

cmd_uninstall() { # uninstall [--apply] : inverso selectivo por manifiesto, con backup previo
  local apply="${1:-preview}"
  local list src f n=0
  safe_tree "$MANAGED" || return 1
  if [ -f "$MANAGED" ]; then list=$(cat "$MANAGED") || return 1; else list=$(managed_list) || return 1; fi
  # Validar todo antes de borrar; manifiestos antiguos no autorizan memoria viva.
  while IFS= read -r f; do
    case "$f" in ''|opencode/memory/MEMORY.md) continue ;; esac
    managed_path "$f" || { echo "[error] ruta no gestionada: $f" >&2; return 1; }
  done <<< "$list"
  if [ "$apply" = "--apply" ]; then
    local bk
    bk=$(mktemp -d "$CFG/.pre-uninstall-XXXXXXXX") || return 1
  fi
  while IFS= read -r f; do
    case "$f" in ''|opencode/memory/MEMORY.md) continue ;; esac
    src="$CFG/${f#opencode/}"
    [ -e "$src" ] || continue
    if [ "$apply" = "--apply" ]; then
      [ -f "$src" ] || return 1
      mkdir -p "$bk/$(dirname "$f")" || return 1
      cp -a "$src" "$bk/$f" || return 1
      rm -f "$src" || return 1
      echo "[rm] $src (backup en $bk)"
    else
      echo "[pdte] $src"
    fi
    n=$((n + 1))
  done <<< "$list"
  echo "gestionados: $n (modo: $apply)"
  echo "retenidos: .env, memoria viva, logs, backups y plugins personales (no son gestionados por el ecosistema)"
}

case "${1:-status}" in
  status) cmd_status ;;
  sync) cmd_sync "${2:-}" ;;
  publish) cmd_publish "${2:-}" ;;
  capture) cmd_capture "${2:-}" ;;
  uninstall) cmd_uninstall "${2:-preview}" ;;
  *) echo "uso: $0 {status|sync --apply|publish --yes|capture --apply|uninstall [--apply]}"; exit 2 ;;
esac
