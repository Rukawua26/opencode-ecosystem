{
  "$schema": "https://opencode.ai/config.json",
  // 001-ecosystem-lite: config mínima válida. Sin MCP locales hasta que existan los binarios.
  // 004-A: `opencode models --verbose` (2026-09-11) no lista provider ollama: los 1-3B
  // no están cableados. Si se cablea, filtrar solo toolcall=true (patron gentle-ai).
  "snapshot": true,
  "autoupdate": false,
  // 004-B: nunca se comparte (votado). Preserva tu valor si lo gestionas por proyecto.
  "share": "disabled",
  // 008: fondo barato (títulos/compactación). Cascada completa: ~/docs/runbooks/runbook-cascada-modelos.md
  "small_model": "opencode/nemotron-3-ultra-free",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol":   { "variants": { "low": { "reasoningEffort": "low", "textVerbosity": "low" } } },
        "gpt-5.6-terra": { "variants": { "low": { "reasoningEffort": "low", "textVerbosity": "low" } } },
        "gpt-5.6-luna":  { "variants": { "low": { "reasoningEffort": "low", "textVerbosity": "low" } } }
      }
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 8000
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".venv/**", "target/**"]
  },
  // 002-gentle-alignment P2: deny-list seguridad (patron gentle-ai/permissions, solo OpenCode).
  // Defaults no rompen nada: read/edit siguen allow salvo estas rutas; bash sigue allow salvo ssh-family (ask).
  "permission": {
    "read": {
      "~/.ssh/*": "deny",
      "~/.ssh/**/*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "~/.aws/credentials": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.credentials/*": "deny",
      "**/secrets/*": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny"
    },
    "edit": {
      "~/.ssh/*": "deny",
      "~/.ssh/**/*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/.env*": "deny",
      "~/.aws/credentials": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.credentials/*": "deny",
      "**/secrets/*": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny"
    },
    "bash": {
      "*": "allow",
      "ssh *": "ask",
      "scp *": "ask",
      "sftp *": "ask",
      "rsync *": "ask"
    }
  },
  // 004-D: Context7 opt-in (docs vivas de libs). enabled:false = 0 tokens hasta activarlo.
  // Activar: "enabled": true (+ CONTEXT7_API_KEY opcional para rate-limits). Patron gentle-ai.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  },
  // ODD delegado en contexto fresco.
  // 0 tokens al arranque: los prompts solo se cargan cuando el subagente se invoca.
  // Reversible: quitar bloque + sync.
  "agents": {
    "odd-worker": {
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-luna#low",
      "description": "Ejecutor ODD: implementa una tarea atomica de odd/tasks con verificacion y salida RESULT",
      "system": "Eres el ejecutor ODD, no el orquestador. Lee el documento ODD indicado en el prompt y localiza la tarea exacta con su alcance autorizado y criterios. Implementa UNICAMENTE esa tarea con el codigo minimo necesario; no amplies alcance ni toques tareas vecinas. Antes de crear funciones, helpers, formatos o modulos, busca implementaciones equivalentes en el proyecto, identifica la canonica y reutilizala; si no la reutilizas, justificalo brevemente en el documento ODD. No conviertas la busqueda en investigacion abierta. Si Decisiones aceptadas contiene una decision que resuelve tu bloqueo, aplicala. Ejecuta la verificacion declarada. No delegues ni lances subagentes. Al terminar escribe 'SUMMARY: <una linea breve>' y como ultima linea 'RESULT: success', 'RESULT: blocked' o 'RESULT: failed'. RESULT: blocked exige antes 'QUESTION: <una sola pregunta concreta>'; RESULT: success exige SUMMARY no vacio; el runner rechaza como error de contrato cualquier salida incompleta y jamas la marca como done. No emitas NEXT_TRANSITION ni comandos de continuacion: solo el control-plane registrado puede publicar transiciones ejecutables. Nunca termines sin RESULT.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "odd-verifier": {
      "mode": "subagent",
      "hidden": true,
      "description": "Verificador ODD read-only: contrasta implementacion y criterios del documento odd/tasks",
      "system": "Eres el verificador ODD, read-only. Lee el documento ODD indicado, la tarea implementada y el diff o salidas indicadas. Contrasta la implementacion con el alcance autorizado, la seccion No romper, los criterios de aceptacion y la reutilizacion investigada. Comprueba duplicacion de codigo solo ante evidencia concreta; no abras exploraciones amplias. Puerta de precision: reporta solo hallazgos reales con evidencia; en duda, silencio. Al terminar escribe 'SUMMARY: <hallazgos clave o Sin hallazgos.>' (obligatorio) y como ultima linea 'RESULT: success' o 'RESULT: failed'. Usa failed solo ante un criterio incumplido o verificacion objetiva fallida. Este agente solo se usa tras un odd-worker completado; una verificacion sin worker previo es inconclusa. No emitas NEXT_TRANSITION ni comandos de continuacion: solo el control-plane registrado puede publicar transiciones ejecutables. Nunca modifiques archivos ni lances subagentes.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
